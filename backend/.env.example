# ==============================================================================
# XAVITECH-2026 Backend Environment Variables Template
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
# For production: https://xavitech.in

# PostgreSQL / Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Firebase Authentication (Google Login Verification - Phase 2)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Brevo - Transactional Emails (Phase 8 Part 4)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@xavitech2026.com
BREVO_SENDER_NAME="XAVITECH 2026"
FRONTEND_URL=https://xavitech.in
EMAIL_SEND_ENABLED=false


# Easebuzz Payment Gateway (Live Integration)
EASEBUZZ_KEY=your_easebuzz_merchant_key
EASEBUZZ_SALT=your_easebuzz_merchant_salt
EASEBUZZ_ENV=production
EASEBUZZ_LIVE_ENABLED=false
EASEBUZZ_LIVE_TEST_EVENT_SLUG=
EASEBUZZ_TEST_FEE_OVERRIDE_ENABLED=false
EASEBUZZ_TEST_FEE_AMOUNT=1.00
# Optional Sub-merchant ID if applicable
# EASEBUZZ_SUB_MERCHANT_ID=

# Admin Authentication (Phase 6)
ADMIN_SECRET_KEY=change-this-to-a-long-random-secret

# Cloudinary - Document & Image Storage (Phase 2 Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

