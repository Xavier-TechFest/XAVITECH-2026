# ==============================================================================
# XAVITECH-2026 Backend Environment Variables Template
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# PostgreSQL / Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Firebase Authentication (Google Login Verification - Phase 2)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Brevo - Transactional Emails (Phase 4)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=noreply@xavitech2026.com
BREVO_SENDER_NAME="XAVITECH 2026"

# Payment Gateway (Phase 3)
PAYMENT_GATEWAY_KEY_ID=your_payment_key_id
PAYMENT_GATEWAY_KEY_SECRET=your_payment_key_secret
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret
